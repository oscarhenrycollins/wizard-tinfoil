{
  "openapi": "3.0.3",
  "info": {
    "title": "Tinfoil Connection",
    "version": "0.4.0"
  },
  "components": {
    "securitySchemes": {
      "RouterGrant": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Wizard-Grant",
        "description": "Grant whose incoming identity is wizard-connection-router in WIZARD_GRANTS_FILE. No browser/owner credentials or local gateway bearer."
      }
    }
  },
  "paths": {
    "/api/infer": {
      "post": {
        "description": "Router-only wizard.ai-connection/2 inference through the official attested Python SDK. Body: model, optional system, messages (user/assistant text), max_tokens, stream, abilities. Always SSE, including stream:false: delta data {type:delta,text}, then done {type:done,model,usage} or error {type:error,code}. Codes: signed_out, limit, unreachable, provider_error. No implicit model substitution or upstream URL overrides.",
        "security": [
          {
            "RouterGrant": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "system": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32768
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "abilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "text",
                        "streaming"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inference SSE",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid Router grant, forwarded request or browser credentials"
          }
        }
      }
    },
    "/v1/live": {
      "get": {
        "description": "Router-only WebSocket wizard.live-transcription/1. First text: start with format pcm_s16le, sample_rate 16000, channels 1, language null. Then binary PCM frames <=65536 bytes and text commit or stop. Replies: ready (provider/model), delta/final (text), error (code/message), closed then normal close. Audio before ready is queued. Each committed utterance rotates the official attested Tinfoil realtime session; no audio or transcripts are logged.",
        "security": [
          {
            "RouterGrant": []
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket established"
          },
          "400": {
            "description": "WebSocket upgrade required"
          },
          "403": {
            "description": "Router grant required"
          }
        }
      }
    },
    "/api/connection": {
      "get": {
        "description": "Box-only wizard.ai-connection/2 status and catalog-backed model descriptors (id, label, tier, abilities, context). Includes the /1 status, gateway and credential-verification fields. No secret or provider I/O; cached last successful verification.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/api/connect": {
      "post": {
        "description": "Verify enclave and list models before atomically saving key. Requires trusted Origin and X-Wizard-Request: 1. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/test": {
      "post": {
        "description": "Verify stored login and refresh models; empty object. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "description": "Delete stored key and rotate local gateway credential; empty object.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "description": "Box-only local bearer-authenticated connected models.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "Box-only local bearer-authenticated official SDK inference; paid when invoked. Supports buffered SSE. No upstream URL overrides.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "description": "Box-only read-only connection_status MCP.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/admin-key": {
      "post": {
        "description": "Owner page only (trusted Origin + X-Wizard-Request). Save an optional Tinfoil admin key used solely to read billing (usage cost, transactions). Verified against Tinfoil before saving; never returned.",
        "responses": {
          "200": {
            "description": "Sanitized status"
          },
          "400": {
            "description": "Rejected key, nothing saved"
          },
          "403": {
            "description": "Untrusted origin"
          }
        }
      }
    },
    "/api/admin-key/remove": {
      "post": {
        "description": "Delete the saved billing key.",
        "responses": {
          "200": {
            "description": "Sanitized status"
          }
        }
      }
    },
    "/api/private-clients": {
      "post": {
        "description": "Owner/box-only; same guards as /api/connect. Mint or rotate an agent's relay bearer; only SHA-256 is stored. Never expose this route as an agent tool.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent"
                ],
                "additionalProperties": false,
                "properties": {
                  "agent": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Opaque token and relay_url; no provider key"
          },
          "400": {
            "description": "Invalid agent or body"
          },
          "403": {
            "description": "Owner write guards refused"
          }
        }
      }
    },
    "/api/private-clients/{agent}": {
      "delete": {
        "description": "Owner/box-only; same guards as /api/connect. Idempotently revoke the agent's relay bearer.",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked (also when absent)"
          },
          "400": {
            "description": "Invalid agent"
          },
          "403": {
            "description": "Owner write guards refused"
          }
        }
      }
    }
  }
}
