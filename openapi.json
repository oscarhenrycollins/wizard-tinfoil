{
  "openapi": "3.0.3",
  "info": {
    "title": "Tinfoil Connection",
    "version": "0.3.0"
  },
  "paths": {
    "/api/private-clients": {
      "post": {
        "description": "Owner/box-only; same guards as /api/connect. Mint or rotate an agent's relay bearer; only SHA-256 is stored. Never expose this route as an agent tool.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["agent"], "additionalProperties": false, "properties": {"agent": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}}}}}},
        "responses": {"200": {"description": "Opaque token and relay_url; no provider key"}, "400": {"description": "Invalid agent or body"}, "403": {"description": "Owner write guards refused"}}
      }
    },
    "/api/private-clients/{agent}": {
      "delete": {
        "description": "Owner/box-only; same guards as /api/connect. Idempotently revoke the agent's relay bearer.",
        "parameters": [{"name": "agent", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}}],
        "responses": {"204": {"description": "Revoked (also when absent)"}, "400": {"description": "Invalid agent"}, "403": {"description": "Owner write guards refused"}}
      }
    },
    "/api/connection": {
      "get": {
        "description": "Box-only wizard.ai-connection/1 status, no secret. No provider I/O; cached last successful verification. Chat models use [{id,label}] objects.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/api/connect": {
      "post": {
        "description": "Verify enclave and list models before atomically saving key. Requires trusted Origin and X-Wizard-Request: 1. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/test": {
      "post": {
        "description": "Verify stored login and refresh models; empty object. No paid inference.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "description": "Delete stored key and rotate local gateway credential; empty object.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "description": "Box-only local bearer-authenticated connected models.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "Box-only local bearer-authenticated official SDK inference; paid when invoked. Supports buffered SSE. No upstream URL overrides.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "description": "Box-only read-only connection_status MCP.",
        "responses": {
          "200": {
            "description": "Successful sanitized result"
          },
          "403": {
            "description": "Untrusted host, origin or forwarded request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
